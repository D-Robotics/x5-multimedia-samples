CROSS_COMPILE ?= /opt/arm-gnu-toolchain-11.3.rel1-x86_64-aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-

ifeq ($(BUILD_VERBOSE),1)
	Q =
else
	Q = @
endif

CC = ${CROSS_COMPILE}gcc
CXX = ${CROSS_COMPILE}g++
AR = ${CROSS_COMPILE}ar
AS = ${CROSS_COMPILE}as
LD = ${CROSS_COMPILE}ld

STRIP = ${CROSS_COMPILE}strip
RANLIB = ${CROSS_COMPILE}ranlib
OBJCOPY = ${CROSS_COMPILE}objcopy
OBJDUMP = ${CROSS_COMPILE}objdump
READELF = ${CROSS_COMPILE}readelf
NM = ${CROSS_COMPILE}nm

CFLAGS = -Wall -Werror
CXXFLAGS = -Wall -Werror
CFLAGS_DYNAMIC = -fPIC -shared
CFLAGS_STATIC = -rcs
LDFLAGS =

# Get the absolute path of the directory where Makefile.in is located
PLATFORM_SAMPLES_DIR := $(shell dirname $(realpath $(lastword $(MAKEFILE_LIST))))

HR_TOP_DIR = $(shell realpath ${PLATFORM_SAMPLES_DIR}/../../../)
ifeq ($(HR_BUILD_OUTPUT_DIR),)
HR_BUILD_OUTPUT_DIR = ${HR_TOP_DIR}/out
$(info HR_BUILD_OUTPUT_DIR not set so use default path: [$(HR_BUILD_OUTPUT_DIR)])
endif

ifneq ($(MAKECMDGOALS), clean)
ifeq ($(wildcard $(HR_BUILD_OUTPUT_DIR)),)
    $(info HR_BUILD_OUTPUT_DIR [$(HR_BUILD_OUTPUT_DIR)], is not exit. )
    $(info -  The meaning of HR_BUILD_OUTPUT_DIR is the directory where the SDK compiles the output results)
    $(info -  Two methods to solve it:)
    $(info -    1. export HR_BUILD_OUTPUT_DIR=...)
    $(info -    2. Directly modify the default value of HR_BUILD_OUTPUT_DIR in line 33 of this document.)
    $(error exit)
else
    $(info HR_BUILD_OUTPUT_DIR directory is exit: [$(HR_BUILD_OUTPUT_DIR)])
endif
endif


ifeq ($(APP_DEPLOY_DIR),)
APP_DEPLOY_DIR = ${HR_BUILD_OUTPUT_DIR}/deploy/app
endif

PLATFORM_SAMPLES_DEPLOY_DIR = ${APP_DEPLOY_DIR}/platform_samples

INCS += -I . \
	-I ${HR_BUILD_OUTPUT_DIR}/build/hbre_deps/include/ \
	-I ${HR_BUILD_OUTPUT_DIR}/deploy/system/usr/include/ \
	-I ${PLATFORM_SAMPLES_DIR}/include/ \
	-I ${PLATFORM_SAMPLES_DIR}/utils/ \
	-I ${PLATFORM_SAMPLES_DIR}/vp_sensors

LIBSDIR = 	-L ${HR_BUILD_OUTPUT_DIR}/build/hbre_deps/usr/lib \
		-L ${HR_BUILD_OUTPUT_DIR}/deploy/system/usr/lib \
		-L ${PLATFORM_SAMPLES_DIR}/lib

ifeq (${HR_SYSTEM_TYPE},ubuntu)
INCS += -I${DEPLOY_SYSTEM_DIR}/usr/include/aarch64-linux-gnu
INCS += -I${DEPLOY_SYSTEM_DIR}/usr/aarch64-linux-gnu/include
CFLAGS += --sysroot=${DEPLOY_SYSTEM_DIR}/
CXXFLAGS += --sysroot=${DEPLOY_SYSTEM_DIR}/
LIBSDIR += --sysroot=${DEPLOY_SYSTEM_DIR}/
LIBSDIR += -L${DEPLOY_SYSTEM_DIR}/lib/aarch64-linux-gnu
LIBSDIR += -L${DEPLOY_SYSTEM_DIR}/usr/aarch64-linux-gnu/lib
LIBSDIR += -L${DEPLOY_SYSTEM_DIR}/usr/lib/aarch64-linux-gnu
LIBSDIR += -Wl,-rpath-link=${DEPLOY_SYSTEM_DIR}/lib/aarch64-linux-gnu
LIBSDIR += -Wl,-rpath-link=${DEPLOY_SYSTEM_DIR}/usr/aarch64-linux-gnu/lib
LIBSDIR += -Wl,-rpath-link=${DEPLOY_SYSTEM_DIR}/usr/lib/aarch64-linux-gnu
endif

LIBS = 	-lcam \
	-lvpf \
	-lhbmem \
	-lgdcbin \
	-lcjson \
	-lpthread \
	-lalog \
	-ldl

$(info PLATFORM_SAMPLES_DIR directory (absolute): $(PLATFORM_SAMPLES_DIR))

SRC_PATH = $(shell pwd)
SRC_PATH += ${PLATFORM_SAMPLES_DIR}/utils
SRC_PATH += $(shell find ${PLATFORM_SAMPLES_DIR}/vp_sensors -maxdepth 1 -type d)
