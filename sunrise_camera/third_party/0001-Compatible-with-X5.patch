diff --git a/build_x5.sh b/build_x5.sh
new file mode 100755
index 00000000..1702e4b8
--- /dev/null
+++ b/build_x5.sh
@@ -0,0 +1,55 @@
+#!/bin/bash
+
+RELEASE_LIB_SRC_PATH="release/linux/RELEASE"
+if [ -d "$RELEASE_LIB_SRC_PATH" ]; then
+    echo "Removing existing instaled directory..."
+    rm -rf "$RELEASE_LIB_SRC_PATH"
+fi
+
+# 1. 检测 build 目录是否存在，如果存在就删除，如果不存在就创建
+if [ -d "build" ]; then
+    echo "build directory exists, removing it..."
+    rm -rf build
+fi
+mkdir build
+
+# 2. 进入 build 目录
+cd build || exit
+
+# 3. 执行 cmake 命令
+cmake -DCMAKE_BUILD_TYPE="RELEASE" -DCMAKE_TOOLCHAIN_FILE=../cmake/aarch64_toolchain.cmake -DENABLE_API_STATIC_LIB=ON ..
+
+# 4. 执行 make 命令
+make -j
+
+# 5. 回到上级目录
+cd ..
+
+#安装 头文件
+# 设置目标路径
+TARGET_INCLUDE="../../Transport/media_server/mk_api/include"
+TARGET_LIB="../../Transport/media_server/mk_api/lib"
+
+# 1. 处理 include 目录
+if [ -d "$TARGET_INCLUDE" ]; then
+    echo "Removing existing include directory..."
+    rm -rf "$TARGET_INCLUDE"
+fi
+
+echo "Copying include files..."
+cp -af api/include "$TARGET_INCLUDE"
+
+# 2. 处理 lib 目录
+if [ -d "$TARGET_LIB" ]; then
+    echo "Removing existing lib directory..."
+    rm -rf "$TARGET_LIB"
+fi
+
+echo "Copying library files..."
+mkdir -p "$TARGET_LIB"  # 确保目标目录存在
+
+
+cp -af $RELEASE_LIB_SRC_PATH/*.a "$TARGET_LIB/"
+
+echo "Operation completed!"
+
diff --git a/cmake/aarch64_toolchain.cmake b/cmake/aarch64_toolchain.cmake
new file mode 100644
index 00000000..cf67ffdb
--- /dev/null
+++ b/cmake/aarch64_toolchain.cmake
@@ -0,0 +1,43 @@
+# 指定 CMake 版本（可选）
+cmake_minimum_required(VERSION 3.10)
+
+# 指定交叉编译工具链路径
+set(TOOLCHAIN_PATH "/opt/arm-gnu-toolchain-11.3.rel1-x86_64-aarch64-none-linux-gnu")  # 你的 ARM64 交叉编译工具链目录
+set(CMAKE_SYSTEM_NAME Linux)                # 目标系统（Linux）
+set(CMAKE_SYSTEM_PROCESSOR aarch64)         # 目标架构（ARM64）
+
+# 指定交叉编译器
+set(CMAKE_C_COMPILER   ${TOOLCHAIN_PATH}/bin/aarch64-none-linux-gnu-gcc)
+set(CMAKE_CXX_COMPILER ${TOOLCHAIN_PATH}/bin/aarch64-none-linux-gnu-g++)
+set(CMAKE_ASM_COMPILER ${CMAKE_C_COMPILER})
+
+# 指定 sysroot
+set(SYSTEM_SYSROOT ${CMAKE_CURRENT_LIST_DIR}/../../../../../../../out/deploy/system/usr/)
+
+set(CMAKE_SYSROOT ${TOOLCHAIN_PATH}/aarch64-none-linux-gnu/libc)
+set(CMAKE_FIND_ROOT_PATH ${SYSTEM_SYSROOT})
+
+# 指定库和头文件搜索路径
+set(CMAKE_C_FLAGS   "--sysroot=${CMAKE_SYSROOT} -march=armv8-a" CACHE STRING "C Compiler flags")
+set(CMAKE_CXX_FLAGS "--sysroot=${CMAKE_SYSROOT} -march=armv8-a" CACHE STRING "C++ Compiler flags")
+
+# 交叉编译时，CMake 只在目标系统路径中查找
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)  # 不在主机系统查找可执行文件
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)   # 仅在交叉编译 sysroot 查找库
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)   # 仅在交叉编译 sysroot 查找头文件
+
+# 设定目标链接器
+set(CMAKE_EXE_LINKER_FLAGS "--sysroot=${CMAKE_SYSROOT} -Wl,-rpath-link,${SYSTEM_SYSROOT}/lib")
+
+# 设置 strip 命令（可选）
+set(CMAKE_STRIP ${TOOLCHAIN_PATH}/bin/aarch64-none-linux-gnu-strip)
+
+link_directories(${SYSTEM_SYSROOT}/lib
+				${CMAKE_SYSROOT}/usr/lib64)
+include_directories(${SYSTEM_SYSROOT}/include
+					${CMAKE_SYSROOT}/usr/include)
+
+set(FFMPEG_PATH_ROOT "${SYSTEM_SYSROOT}/" CACHE PATH "Path to FFmpeg installation")
+
+# 启用调试模式，打印查找过程
+# set(CMAKE_FIND_DEBUG_MODE TRUE)
diff --git a/src/Record/MP4Muxer.cpp b/src/Record/MP4Muxer.cpp
